# ============================================================
# SERVER / NETWORK
# ============================================================
APP_NAME=project-management-backend
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080

# ============================================================
# DATABASE
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pmt
DB_USERNAME=postgres
DB_PASSWORD=change-me

# ============================================================
# JPA / FLYWAY
# ============================================================
JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=true
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_LOCATIONS=classpath:db/migration

# ============================================================
# FILE UPLOADS
# ============================================================
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=100MB
JACKSON_WRITE_DATES_AS_TIMESTAMPS=false

# ============================================================
# JWT
# Generate a strong random secret for production.
# ============================================================
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=project-management-api

# ============================================================
# AUTHENTICATION
# ============================================================
AUTH_REFRESH_EXPIRATION_DAYS=7
AUTH_PASSWORD_RESET_EXPIRATION_MINUTES=10
AUTH_EMAIL_VERIFICATION_EXPIRATION_HOURS=24
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MINUTES=15

# ============================================================
# FRONTEND / CORS
# IMPORTANT: This is the URL used by clients to open the frontend.
# Replace 10.180.102.238 with this PC's LAN IPv4 address if it changes.
# Multiple origins can be comma-separated.
# ============================================================
APP_FRONTEND_URL=http://10.180.102.238:5173
APP_CORS_ALLOWED_ORIGINS=http://10.180.102.238:5173,http://localhost:5173,http://127.0.0.1:5173

# ============================================================
# EMAIL
# ============================================================
APP_MAIL_ENABLED=false
APP_MAIL_FROM=no-reply@projectmanagement.local
APP_NOTIFICATION_EMAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# ============================================================
# WEB PUSH
# ============================================================
APP_NOTIFICATION_WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@projectmanagement.local

# ============================================================
# SECURITY
# ============================================================
APP_SECURITY_TRUST_FORWARDED_HEADERS=false

# ============================================================
# SCHEDULERS
# ============================================================
REMINDER_SCHEDULER_DELAY_MS=60000
OVERDUE_TICKET_SCHEDULER_DELAY_MS=300000

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_SPRING_WEB=INFO
LOG_LEVEL_HIBERNATE_SQL=WARN
